# Telegram bot token from @BotFather
BOT_TOKEN=
# DeepL API Free key (ends with ":fx")
DEEPL_API_KEY=
# Comma-separated Telegram user IDs of admins
ADMIN_IDS=

POLL_INTERVAL_MIN=30
# Hours when nothing is published, e.g. 22-7; leave empty to disable
QUIET_HOURS=22-7
TIMEZONE=Europe/Berlin
STALE_DAYS=7
DB_PATH=data/bot.db

# Max posts per chat per publishing cycle
BATCH_LIMIT=5
# Contact shown in the HTTP User-Agent (email or URL), as a courtesy to site owners
CONTACT=
GLOSSARY_PATH=glossary.yaml
LOG_LEVEL=INFO
